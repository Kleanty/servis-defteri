# Bu dosyayı ".env" olarak kopyala:   cp .env.example .env && chmod 600 .env
# .env dosyanı kimseyle paylaşma, GitHub'a yükleme (.gitignore zaten dışlar).
# Aşağıdakilerin HİÇBİRİ zorunlu değil; boş bırakılan değerler için güvenli varsayılan kullanılır.

# ---- İşletme bilgileri (vitrin sayfası, QR sayfası, etiket, WhatsApp mesajları) ----
ISLETME_ADI=Servis Defteri
# Vitrindeki "Ara" / "WhatsApp" düğmeleri için. Boşsa düğmeler gizlenir.
# Panelin sol üst köşesindeki kısa ad (boşsa ISLETME_ADI kullanılır)
ISLETME_KISA_AD=
ISLETME_TEL=0555 000 00 00
ISLETME_ADRES=Örnek Mah. Sanayi Sitesi No:1, Şehir
# İkinci telefon (sabit hat) ve e-posta: isteğe bağlı, vitrinin iletişim bölümünde görünür.
ISLETME_TEL2=
ISLETME_YETKILI=
ISLETME_EPOSTA=
# Google puanı rozeti (isteğe bağlı): ISLETME_PUAN=5,0  ISLETME_YORUM_SAYISI=15  ISLETME_YORUM_LINK=<Google Haritalar adresi, boşsa HARITA_LINK>
ISLETME_PUAN=
ISLETME_YORUM_SAYISI=
ISLETME_ACIKLAMA=Arıza tespiti, periyodik bakım ve onarım. Sorunun kaynağını ilk seferde bulur, yaptığımız işi şeffafça gösteririz.
ACILIS_SAATI=09:00
KAPANIS_SAATI=19:00
SAAT_DILIMI=Europe/Istanbul
# Google Haritalar > Paylaş > Harita yerleştir > iframe içindeki src="..." adresi (boşsa harita gösterilmez)
HARITA_EMBED_URL=
# "Yol tarifi" düğmesi için Google Haritalar bağlantısı
HARITA_LINK=

# ---- QR kodlarının gideceği herkese açık adres ----
# Telefondan okutulan QR bu adrese gider. Gerçek bir alan adın yoksa (yalnızca deneme) boş bırak.
# Site alan adında (ör. https://alanadiniz.com) açıldıktan SONRA yaz; önce yazarsan etiket QR'ları açılmayan adrese gider.
PUBLIC_BASE_URL=

# ---- Etiket yazıcı (isteğe bağlı) ----
# Etikette yazan ad (en fazla ~18 karakter, Türkçe harfler ASCII'ye çevrilir). Boşsa SERVIS DEFTERI.
ETIKET_BASLIK=SERVIS DEFTERI
# Yazıcının USB kimliği (lsusb). Varsayılan Xprinter XP-470B (2d37:82c5); farklı yazıcıda kendi kimliğini yaz:
# ETIKET_USB_ID=2d37:82c5
# Etiket kayık/ters çıkarsa: ETIKET_X_OFFSET (varsayılan 24 = 3 mm sağa), ETIKET_Y_OFFSET (varsayılan 16 = 2 mm aşağı),
# ETIKET_YON (0/1), ETIKET_GAP_MM, ETIKET_YOGUNLUK (1-15). 8 nokta = 1 mm.

# Windows'ta: yazıcının adı (ya da bir parçası). Boşsa adında xp-470 / xprinter / etiket / label geçen ilk yazıcı seçilir.
# Hangi adlar var? windows\YAZICILARI-LISTELE.bat. (Kâğıt yazıcısına etiket gönderilmez.)
# ETIKET_YAZICI_ADI=XP-470B

# ---- Çalıştırma (Windows: scripts/calistir.py bunları okur) ----
# PORT=5000
# Yalnızca bu bilgisayardan/tünelden erişim için 127.0.0.1 (varsayılan). Dükkan Wi-Fi'sindeki telefonlar doğrudan
# http://BILGISAYAR-IP:5000 ile bağlansın istiyorsan 0.0.0.0 yap (Windows güvenlik duvarı izin sorar).
# DINLE_ADRES=127.0.0.1
# NOT: .env değerlerinin yanına yorum (#) yazma; yorumlar ayrı satırda olmalı.

# ---- Yedek (isteğe bağlı) ----
# Windows: yedeğin ikinci kopyası (USB bellek, ikinci disk, Google Drive / OneDrive klasörü):
# YEDEK_KLASORU=D:\ServisYedek
# USB bellek yedeği: birim adı servisyedek olan bellek takılınca yedek oraya da gider (başka ad için:)
# USB_YEDEK_ADI=servisyedek
# rclone ile bulut yedeği: "rclone config" ile bir uzak kaynak (örn. gdrive) tanımla, sonra:
# RCLONE_REMOTE=gdrive:ServisDefteri-Yedek

# ---- Gelişmiş ----
# Yalnızca yerel ağda http:// ile denerken: 0 yap (üretimde 1 kalmalı).
# FORCE_HTTPS_COOKIE=1
# SECRET_KEY'i elle vermek istersen (normalde gerekmez; data/.secret_key otomatik üretilir).
# SECRET_KEY=
# Şifre hash'ini ortam değişkeniyle vermek istersen (normalde python scripts/sifre_degistir.py kullan).
# APP_PASSWORD_HASH=

# --- DIŞ SİSTEM API ENTEGRASYONU (isteğe bağlı; muhasebe/servis yazılımı Servis Defteri'ne kayıt gönderir) ---
# Adres: https://alanadiniz.com/api/v1/is-emirleri   (belge: docs/Servis-Defteri-Entegrasyon-API.pdf)
# Anahtarı rastgele ve uzun seç (en az 32 karakter); boş bırakılırsa API KAPALI kalır (kurulum otomatik üretir).
# ENTEGRASYON_API_ANAHTARI=
# Ustanın girdiği km ile gelen km en çok kaç km farklı olabilir (fazlaysa eşleşmez, incelemeye düşer)
# ENTEGRASYON_KM_TOLERANS=50
# Açık iş emri kaç günden eskiyse kayıt otomatik bağlanmaz, incelemeye düşer
# ENTEGRASYON_GUN_ARALIGI=5
# Düz http ile gelen isteği reddet (1=evet, önerilen)
# ENTEGRASYON_HTTPS_ZORUNLU=1
# 1: kayit_no olmayan istek reddedilir (mükerrer önlemenin en güvenilir yolu)
# ENTEGRASYON_KAYIT_NO_ZORUNLU=0
# 1 yaparsan: plaka kayıtsızsa/açık iş emri yoksa gelen kayıt doğrudan yeni iş emri açar (varsayılan 0: incelemeye alınır)
# ENTEGRASYON_YENI_KAYIT=0

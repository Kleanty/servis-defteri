# Servis Defteri yazdirma ajani ayarlari. Bu dosyayi "ajan.env" adiyla kopyala ve doldur (Windows'ta AJAN-KUR.bat bunu kendisi yazar).
SUNUCU=https://servis.ornek.com
ANAHTAR=ya_xxxx_yoneticinin-verdigi-anahtar
